{
  "name": "@fleetfizz/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && vp config --no-agent",
    "build": "vp run --filter fleetfizz build",
    "images": "vp run --filter @fleetfizz/brand-assets images",
    "video": "vp run --filter @fleetfizz/video dev",
    "video:render": "vp run --filter @fleetfizz/video render",
    "typecheck": "vp run -r typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp run -r test",
    "e2e": "pnpm build && vp run --filter @fleetfizz/e2e e2e",
    "e2e:darwin": "pnpm build && E2E_FLEET=mixed vp run --filter @fleetfizz/e2e e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
