{
  "name": "fleetfizz",
  "version": "0.13.0",
  "description": "Keep every Machine on your tailnet in line with one config.",
  "keywords": [
    "agent-skills",
    "cli",
    "dev-environment",
    "dotfiles",
    "fleet",
    "homebrew",
    "ssh",
    "sync",
    "tailscale",
    "vite-plus"
  ],
  "homepage": "https://fleetfizz.com",
  "bugs": "https://github.com/connorch/fleetfizz/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connorch/fleetfizz.git",
    "directory": "apps/cli"
  },
  "bin": {
    "fizz": "./dist/fleetfizz.mjs",
    "fleetfizz": "./dist/fleetfizz.mjs"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir . --passWithNoTests",
    "schema": "node scripts/write-schema.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@fleetfizz/config": "workspace:*",
    "@fleetfizz/core": "workspace:*",
    "@fleetfizz/providers": "workspace:*",
    "@fleetfizz/remote": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "cli-spinners": "catalog:",
    "effect": "catalog:",
    "ink": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
