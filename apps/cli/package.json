{
  "name": "fleetfizz",
  "version": "0.0.0",
  "description": "Keep every Machine on your tailnet in line with one config.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connorch/fleetfizz.git",
    "directory": "apps/cli"
  },
  "bin": {
    "fleetfizz": "./dist/fleetfizz.mjs"
  },
  "files": [
    "dist",
    "fleet.schema.json"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --config ../../vite.config.ts --dir . --passWithNoTests",
    "schema": "node scripts/write-schema.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@fleetfizz/config": "workspace:*",
    "@fleetfizz/core": "workspace:*",
    "@fleetfizz/remote": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
