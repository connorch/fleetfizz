{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleetfizz config",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "machines": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "clones": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["darwin", "linux"]
            }
          },
          "machines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "install": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["origin", "ref", "install"],
        "additionalProperties": true
      }
    },
    "vp": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["darwin", "linux"]
          }
        },
        "machines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "globals": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {}
}
