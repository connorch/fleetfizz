{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleetfizz config",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "shippedAt": {
      "type": "string"
    },
    "shippedFrom": {
      "type": "string",
      "minLength": 1
    },
    "machines": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "clones": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platforms": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "enum": ["darwin", "linux"]
              }
            ],
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["darwin", "linux"]
            }
          },
          "machines": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "origin": {
            "type": "string",
            "title": "GitHub origin",
            "description": "a GitHub \"owner/repo\""
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "install": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "files": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": ["origin", "ref", "install"],
        "additionalProperties": false
      }
    },
    "vp": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "enum": ["darwin", "linux"]
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["darwin", "linux"]
          }
        },
        "machines": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "globals": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["machines"],
  "additionalProperties": false,
  "$defs": {}
}
