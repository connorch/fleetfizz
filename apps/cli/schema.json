{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fleetfizz config",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "shippedAt": {
      "type": "string"
    },
    "shippedFrom": {
      "type": "string",
      "minLength": 1
    },
    "shippedTo": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "machines": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "clones": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "description": "Where this Machine keeps its Managed Clones. `~` expands on that Machine. Default: `~/.local/share/fleetfizz/clones`."
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "description": "The Fleet, keyed by each Machine's tailnet name. A tailnet member that is not listed is not part of the Fleet."
        }
      ]
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platforms": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "enum": ["darwin", "linux"]
              }
            ],
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["darwin", "linux"]
            },
            "allOf": [
              {
                "description": "`darwin`, `linux`, or both."
              }
            ]
          },
          "machines": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "allOf": [
              {
                "description": "Machine names from `machines`."
              }
            ]
          },
          "origin": {
            "type": "string",
            "title": "GitHub origin",
            "description": "a GitHub \"owner/repo\"",
            "allOf": [
              {
                "description": "The GitHub `owner/repo`."
              }
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "description": "A branch, or a full 40-character commit SHA to pin it."
              }
            ]
          },
          "install": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "description": "The Install Command, run in a login shell inside the Managed Clone."
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "description": "Names the clone's directory and the repo in output. Default: `<owner>-<repo>`."
              }
            ]
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "allOf": [
              {
                "description": "Paths outside the clone the Install Command produces. If one changes by hand, the repo reinstalls."
              }
            ]
          },
          "files": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string"
            },
            "allOf": [
              {
                "description": "Gitignored files written into the clone before every install, keyed by path. Never secrets."
              }
            ]
          }
        },
        "required": ["origin", "ref", "install"],
        "additionalProperties": false
      },
      "allOf": [
        {
          "description": "Each Tracked Repo is cloned on every targeted Machine and installed from its origin ref."
        }
      ]
    },
    "vp": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "enum": ["darwin", "linux"]
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["darwin", "linux"]
          },
          "allOf": [
            {
              "description": "`darwin`, `linux`, or both."
            }
          ]
        },
        "machines": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "description": "Machine names from `machines`."
            }
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["vp", "repos", "brew", "cask"]
          },
          "allOf": [
            {
              "description": "Providers whose Items must succeed on a Machine before vp changes there."
            }
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "description": "The vp version. Pin it exactly."
            }
          ]
        },
        "node": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "description": "The default Node version. Pin it exactly."
            }
          ]
        },
        "globals": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "platforms": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "enum": ["darwin", "linux"]
                      }
                    ],
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": ["darwin", "linux"]
                    },
                    "allOf": [
                      {
                        "description": "`darwin`, `linux`, or both."
                      }
                    ]
                  },
                  "machines": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ],
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allOf": [
                      {
                        "description": "Machine names from `machines`."
                      }
                    ]
                  },
                  "range": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["range"],
                "additionalProperties": false
              }
            ]
          },
          "allOf": [
            {
              "description": "Global packages, each with a Range, or `{ range, platforms?, machines? }` to target one."
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "The vite-plus toolchain."
        }
      ]
    },
    "brew": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "enum": ["darwin", "linux"]
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["darwin", "linux"]
          },
          "allOf": [
            {
              "description": "`darwin`, `linux`, or both."
            }
          ]
        },
        "machines": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "description": "Machine names from `machines`."
            }
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["vp", "repos", "brew", "cask"]
          },
          "allOf": [
            {
              "description": "Providers whose Items must succeed on a Machine before this one changes there."
            }
          ]
        },
        "items": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["*", "latest"],
                "description": "\"*\" (install when missing, never upgrade) or \"latest\" (brew update, then upgrade on every Ship)"
              },
              {
                "type": "object",
                "properties": {
                  "platforms": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "enum": ["darwin", "linux"]
                      }
                    ],
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": ["darwin", "linux"]
                    },
                    "allOf": [
                      {
                        "description": "`darwin`, `linux`, or both."
                      }
                    ]
                  },
                  "machines": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ],
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allOf": [
                      {
                        "description": "Machine names from `machines`."
                      }
                    ]
                  },
                  "range": {
                    "type": "string",
                    "enum": ["*", "latest"],
                    "description": "\"*\" (install when missing, never upgrade) or \"latest\" (brew update, then upgrade on every Ship)"
                  }
                },
                "required": ["range"],
                "additionalProperties": false
              }
            ]
          },
          "allOf": [
            {
              "description": "Formulae, each `\"*\"` or `\"latest\"`, or `{ range, platforms?, machines? }` to target one. A tapped name (`owner/tap/name`) taps on install."
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "Homebrew Formulae. Needs Homebrew on the Machine; a Ship never installs it."
        }
      ]
    },
    "cask": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "enum": ["darwin", "linux"]
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["darwin", "linux"]
          },
          "allOf": [
            {
              "description": "`darwin`, `linux`, or both."
            }
          ]
        },
        "machines": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "description": "Machine names from `machines`."
            }
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["vp", "repos", "brew", "cask"]
          },
          "allOf": [
            {
              "description": "Providers whose Items must succeed on a Machine before this one changes there."
            }
          ]
        },
        "items": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["*", "latest"],
                "description": "\"*\" (install when missing, never upgrade) or \"latest\" (brew update, then upgrade on every Ship)"
              },
              {
                "type": "object",
                "properties": {
                  "platforms": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "enum": ["darwin", "linux"]
                      }
                    ],
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": ["darwin", "linux"]
                    },
                    "allOf": [
                      {
                        "description": "`darwin`, `linux`, or both."
                      }
                    ]
                  },
                  "machines": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ],
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allOf": [
                      {
                        "description": "Machine names from `machines`."
                      }
                    ]
                  },
                  "range": {
                    "type": "string",
                    "enum": ["*", "latest"],
                    "description": "\"*\" (install when missing, never upgrade) or \"latest\" (brew update, then upgrade on every Ship)"
                  }
                },
                "required": ["range"],
                "additionalProperties": false
              }
            ]
          },
          "allOf": [
            {
              "description": "Casks, each `\"*\"` or `\"latest\"`, or `{ range, platforms?, machines? }` to target one. A tapped name (`owner/tap/name`) taps on install."
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "description": "Homebrew Casks, macOS only. Needs Homebrew on the Machine."
        }
      ]
    }
  },
  "required": ["machines"],
  "additionalProperties": false,
  "$defs": {}
}
